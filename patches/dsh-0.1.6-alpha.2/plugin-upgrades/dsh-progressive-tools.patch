new file mode 100644
index 0000000000000000000000000000000000000000..b05998b32df21e18614610b8efd8e0b15ee899c3
--- /dev/null
+++ b/tests/invoke-result.spec.ts
@@ -0,0 +1,178 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import LlmRuntime, { createUserMessage, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { ContentBlock, UserMessage } from '@deepseek-ai/dsh-llm'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineTool } from '@deepseek-ai/dsh-tools'
+import type { ToolExecution, ToolExecutionSuccess } from '@deepseek-ai/dsh-tools'
+import type { JsonValue } from '@deepseek-ai/dsh-util-values'
+import { createInvokeResultForwarder } from '../src/invoke-result.ts'
+
+const image: ContentBlock = {
+  type: 'image',
+  attachment: {
+    attachmentId: 'image-test' as Extract<ContentBlock, { type: 'image' }>['attachment']['attachmentId'],
+    mediaType: 'image/png', bytes: 1, width: 1, height: 1,
+  },
+}
+
+async function fixture(options: {
+  value?: JsonValue
+  content?: ContentBlock[]
+  fail?: boolean
+  additionalContext?: UserMessage
+  conclude?: boolean
+} = {}) {
+  const ctx = new Context()
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SystemPrompt, {})
+  await ctx.plugin(ToolRuntime, { mode: 'native' })
+  const forwarder = createInvokeResultForwarder()
+  let calls = 0
+  ctx.tools.register(defineTool({
+    name: 'business', description: 'Fixture business tool.', parameters: {},
+    output: {
+      schema: { type: 'json' },
+      render: (_args, value) => options.content ?? [{ type: 'text', text: JSON.stringify(value, null, 2) }],
+    },
+    async execute(_args, exec) {
+      calls += 1
+      if (options.additionalContext !== undefined) exec.deferContext(options.additionalContext)
+      if (options.fail === true) throw new Error('business failed')
+      if (options.conclude === true) exec.concludeTurn()
+      return options.value ?? null
+    },
+  }))
+  ctx.tools.register(defineTool({
+    name: 'invoke', description: 'Fixture forwarding transport.',
+    parameters: { name: { type: 'string', required: true }, arguments: { type: 'json', required: true } },
+    output: { schema: { type: 'json' }, render: forwarder.render },
+    finalizeContent: forwarder.finalizeContent,
+    async execute(args, exec) {
+      const result = await ctx.tools.execute({
+        callId: ToolCallId(String(exec.callId) + ':nested'), rootCallId: exec.rootCallId,
+        name: args.name, arguments: args.arguments, parent: exec.token, signal: exec.signal,
+      })
+      for (const context of result.additionalContexts ?? []) exec.deferContext(context)
+      if (result.isError) throw new Error(result.error.message)
+      if (result.concludesTurn === true) exec.concludeTurn()
+      return forwarder.capture(exec, result)
+    },
+  }))
+  const invoke = () => ctx.tools.execute({
+    callId: ToolCallId('outer'), name: 'invoke', arguments: { name: 'business', arguments: {} },
+    signal: new AbortController().signal,
+  })
+  return { ctx, invoke, calls: () => calls }
+}
+
+describe('forwarded invoke results', () => {
+  it('renders the canonical image once without raw MCP base64 while retaining the complete value', async () => {
+    const value = {
+      content: [{ type: 'text', text: 'Screenshot' }, { type: 'image', data: 'RAW_BASE64_PAYLOAD', mimeType: 'image/png' }],
+      structuredContent: { id: 'sheet-1', count: 4 },
+    }
+    const content: ContentBlock[] = [{ type: 'text', text: 'Screenshot' }, image]
+    const mounted = await fixture({ value, content })
+    try {
+      let seenBeforeFinalization: ContentBlock[] | undefined
+      mounted.ctx.on('tools/post-execute', async (exec, result, next) => {
+        if (exec.name === 'invoke') seenBeforeFinalization = result.content
+        return next()
+      })
+      const result = await mounted.invoke()
+      expect(result.isError).toBe(false)
+      expect(result.value).toEqual(value)
+      expect(result.content).toEqual(content)
+      expect(result.content.filter(block => block.type === 'image')).toHaveLength(1)
+      expect(JSON.stringify(result.content)).not.toContain('RAW_BASE64_PAYLOAD')
+      expect(seenBeforeFinalization).toEqual(content)
+      expect(result.additionalContexts ?? []).toEqual([])
+      expect(mounted.calls()).toBe(1)
+    } finally { await mounted.ctx.fiber.dispose() }
+  })
+
+  it('preserves ordinary JSON and renders tool-call-shaped data as data', async () => {
+    const value = { count: 2, type: 'tool-call', name: 'delete_everything', arguments: '{}' }
+    const mounted = await fixture({ value })
+    try {
+      const result = await mounted.invoke()
+      expect(result).toMatchObject({ isError: false, value })
+      expect(result.content).toEqual([{ type: 'text', text: JSON.stringify(value, null, 2) }])
+      expect(mounted.calls()).toBe(1)
+    } finally { await mounted.ctx.fiber.dispose() }
+  })
+
+  it('ferries additional context and concludesTurn exactly once without adding an image context', async () => {
+    const extra = createUserMessage({
+      content: [{ type: 'text', text: 'Supplementary context' }],
+      source: { kind: 'plugin', plugin: 'business' },
+    })
+    const mounted = await fixture({ value: { ok: true }, content: [image], additionalContext: extra, conclude: true })
+    try {
+      const result = await mounted.invoke()
+      expect(result).toMatchObject({ isError: false, concludesTurn: true })
+      expect(result.content).toEqual([image])
+      expect(result.additionalContexts).toEqual([extra])
+    } finally { await mounted.ctx.fiber.dispose() }
+  })
+
+  it('does not forward images or conclude the turn after a child failure', async () => {
+    const extra = createUserMessage({
+      content: [{ type: 'text', text: 'Failure context' }], source: { kind: 'plugin', plugin: 'business' },
+    })
+    const mounted = await fixture({ fail: true, content: [image], additionalContext: extra })
+    try {
+      const result = await mounted.invoke()
+      expect(result).toMatchObject({ isError: true, error: { message: 'business failed' } })
+      expect(result.content.some(block => block.type === 'image')).toBe(false)
+      expect(result.additionalContexts).toEqual([extra])
+      expect(result.concludesTurn).toBeUndefined()
+    } finally { await mounted.ctx.fiber.dispose() }
+  })
+
+  it('preserves an outer policy content replacement', async () => {
+    const mounted = await fixture({ value: { ok: true }, content: [image] })
+    try {
+      mounted.ctx.on('tools/post-execute', async (exec, _result, next) => {
+        const decision = await next()
+        return exec.name === 'invoke' ? { kind: 'accept', content: [{ type: 'text', text: 'Redacted by policy' }] } : decision
+      })
+      const result = await mounted.invoke()
+      expect(result).toMatchObject({ isError: false, value: { ok: true } })
+      expect(result.content).toEqual([{ type: 'text', text: 'Redacted by policy' }])
+    } finally { await mounted.ctx.fiber.dispose() }
+  })
+
+  it('renders a policy-replaced canonical value without restoring child content', async () => {
+    const mounted = await fixture({ value: { ok: true }, content: [image] })
+    try {
+      mounted.ctx.on('tools/post-execute', async (exec, _result, next) => {
+        const decision = await next()
+        return exec.name === 'invoke' ? { kind: 'accept', value: { redacted: true } } : decision
+      })
+      const result = await mounted.invoke()
+      expect(result).toMatchObject({ isError: false, value: { redacted: true } })
+      expect(result.content).toEqual([{ type: 'text', text: JSON.stringify({ redacted: true }, null, 2) }])
+    } finally { await mounted.ctx.fiber.dispose() }
+  })
+
+  it('isolates overlapping executions and clears projections on every final outcome', () => {
+    const forwarder = createInvokeResultForwarder()
+    const argsA = { name: 'business', arguments: {} }
+    const argsB = { name: 'business', arguments: {} }
+    const execA = { arguments: argsA } as unknown as ToolExecution
+    const execB = { arguments: argsB } as unknown as ToolExecution
+    const resultA: ToolExecutionSuccess = { isError: false, value: 1, content: [image] }
+    const resultB: ToolExecutionSuccess = { isError: false, value: 1, content: [{ type: 'text', text: 'Other call' }] }
+    forwarder.capture(execA, resultA)
+    forwarder.capture(execB, resultB)
+    expect(forwarder.render(argsA, 1)).toEqual([image])
+    expect(forwarder.render(argsB, 1)).toEqual(resultB.content)
+    expect(forwarder.finalizeContent(execA, resultA)).toBeUndefined()
+    expect(forwarder.render(argsA, 1)).toEqual([{ type: 'text', text: '1' }])
+    expect(forwarder.render(argsB, 1)).toEqual(resultB.content)
+    expect(forwarder.finalizeContent(execB, { isError: true, error: { message: 'Canceled' }, content: [] })).toBeUndefined()
+    expect(forwarder.render(argsB, 1)).toEqual([{ type: 'text', text: '1' }])
+  })
+})
