diff --git a/test/preset-build.test.mjs b/test/preset-build.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..66bf34a3fed01516dbf6004c8e5456b2b975a181
--- /dev/null
+++ b/test/preset-build.test.mjs
@@ -0,0 +1,36 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { buildPreset } from '../scripts/build-preset.mjs'
+const audit = readFileSync(new URL('../presets/audit/agent.cordis.yml', import.meta.url), 'utf8')
+const code = "- id: persona\n  name: '@deepseek-ai/dsh-persona'\n  config:\n    prefix: Shipped identity\n- id: tool-goal\n  name: '@deepseek-ai/dsh-tool-goal'\n- id: tool-presentation\n  name: '@deepseek-ai/dsh-agent-tool-presentation'\n  config:\n    mode: ptc\n"
+const cordis = "- id: tool-cordis\n  name: '@deepseek-ai/dsh-tool-cordis'\n"
+
+test('regenerating the preset keeps current persona fields and Audit remediation boundaries', () => {
+  const result = buildPreset(code, cordis, audit)
+  assert.match(result, /prefix: \|-\n\s+You are a coding agent/)
+  assert.match(result, /suffix: Your working directory/)
+  assert.match(result, /AUDIT MODE/)
+  assert.match(result, /Only a remediation explicitly accepted by the user/)
+  assert.match(result, /name: ..\/..\/lib\/tool.js/)
+  assert.equal((result.match(/^- id: tool-cordis$/gm) ?? []).length, 1)
+  assert.doesNotMatch(result, /customSkillDirs|Shipped identity/)
+})
+
+
+test('alpha.2 regeneration includes the official persistent management tool without loading repair skills', () => {
+  const officialCordis = cordis + "\n- id: tool-plugin-manager\n  name: '@deepseek-ai/dsh-plugin-manager/tools'\n"
+  const result = buildPreset(code, officialCordis, audit)
+  assert.equal((result.match(/^- id: tool-plugin-manager$/gm) ?? []).length, 1)
+  assert.match(result, /@deepseek-ai\/dsh-plugin-manager\/tools/)
+  assert.doesNotMatch(result, /customSkillDirs/)
+})
+
+
+test('regeneration keeps one management row when the shipped PTC preset already includes it', () => {
+  const management = "\n- id: tool-plugin-manager\n  name: '@deepseek-ai/dsh-plugin-manager/tools'\n"
+  const result = buildPreset(code + management, cordis + management, audit)
+  assert.equal((result.match(/^- id: tool-plugin-manager$/gm) ?? []).length, 1)
+  const ids = [...result.matchAll(/^- id: ([^\n]+)/gm)].map(match => match[1])
+  assert.equal(new Set(ids).size, ids.length, 'top-level preset rows must have unique ids')
+})
