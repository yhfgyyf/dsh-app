index 57ff766..afcd900 100644
--- a/test/config.test.mjs
+++ b/test/config.test.mjs
@@ -63,3 +63,23 @@ test('legacy code selection preserves a separately installed code preset', async
   assert.equal((await roster.resolve('code')).id, 'code')
   restore()
 })
+
+test('profile package lookup determines preset health instead of a disk-only lookup', async () => {
+  const base = 'file:///desktop/profile/'
+  let installed = true
+  const resolves = (specifier, harnessBase) => {
+    assert.equal(harnessBase, base)
+    return installed && specifier === '@deepseek-ai/dsh-skill-filesystem'
+  }
+  const roster = { list: async () => [{ id: 'standard' }] }
+  const discover = async (_roots, harnessBase, lookup) => [{
+    id: 'auto',
+    broken: lookup?.('@deepseek-ai/dsh-skill-filesystem', harnessBase) ? undefined : 'missing plugin'
+  }]
+  const restore = installPresetRoot(roster, discover, '/plugin/presets', base, resolves)
+  assert.equal((await roster.list())[0].broken, undefined)
+  installed = false
+  assert.equal((await roster.list())[0].broken, 'missing plugin', 'a missing dependency remains broken')
+  restore()
+  assert.deepEqual(await roster.list(), [{ id: 'standard' }])
+})
