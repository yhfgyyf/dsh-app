diff --git a/packages/native/src/runtime_probe/linux_loong64.cc b/packages/native/src/runtime_probe/linux_loong64.cc
new file mode 100644
index 0000000..7b8e1ed
--- /dev/null
+++ b/packages/native/src/runtime_probe/linux_loong64.cc
@@ -0,0 +1,33 @@
+#include "parser.h"
+#include "platform.h"
+
+#include <cstring>
+
+namespace esplus::node::require_builtin {
+
+Result<GetterPattern> ParseLinuxLoong64BuiltinModuleRequireGetterOffset(
+    void* getter) {
+  const auto failure = [] {
+    return Result<GetterPattern>::Failure(Status::Failure(
+        ProbeStatus::kUnsupportedNoGetter,
+        "linux-loong64 getter is not the validated framed ld.d a0,this,imm; ret"));
+  };
+  // Decode the shipped old-world Node22 getter; never substitute a fixed field
+  // offset. Unknown compiler prologues and instructions remain unsupported.
+  uint32_t code[7];
+  if (!IsPlatformReadableRange(getter, sizeof(code))) return failure();
+  std::memcpy(code, getter, sizeof(code));
+  if (code[0] != 0x02ffc063 || code[1] != 0x29c02076 ||
+      code[2] != 0x02c04076 || code[3] != 0x28c02076 ||
+      (code[4] & 0xffc003ff) != 0x28c00084 ||
+      code[5] != 0x02c04063 || code[6] != 0x4c000020) return failure();
+  const size_t offset = (code[4] >> 10) & 0xfff;
+  if (offset == 0 || offset >= 0x800 || offset % sizeof(void*) != 0)
+    return failure();
+  GetterPattern pattern;
+  pattern.offset = offset;
+  pattern.pattern = "linux-loong64-framed-ld.d-a0-this-ret";
+  return Result<GetterPattern>::Ok(pattern);
+}
+
+}  // namespace esplus::node::require_builtin
