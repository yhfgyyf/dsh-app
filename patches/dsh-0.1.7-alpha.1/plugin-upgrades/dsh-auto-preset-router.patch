@@ -1,13 +1,33 @@
-import { discoverPresets } from '@deepseek-ai/dsh-agent-presets'
+import { readFile } from 'node:fs/promises'
+import { load as parseYaml } from 'js-yaml'
+import { entryListSchema } from '@deepseek-ai/cordis-plugin-include'
 import { AUTO_PRESET_ROOT, installPresetRoot } from './lib/config.js'
 
 export const name = 'dsh-auto-preset-router'
 export const inject = ['agentPresets']
 
 /** Add the package root to the live roster without replacing the DSH service. */
-export function apply(ctx) {
-  const restore = installPresetRoot(ctx.agentPresets, discoverPresets, AUTO_PRESET_ROOT, ctx.baseUrl)
-  ctx.effect(() => restore, 'dsh-auto-preset-router.roster()')
+export async function apply(ctx) {
+  const presetFile = new URL('./presets/auto/agent.cordis.yml', import.meta.url)
+  const plugins = parseYaml(await readFile(presetFile, 'utf8'), { schema: entryListSchema })
+  const anchor = rows => rows.map(row => ({ ...row,
+    ...(row.name.startsWith('.') ? { name: new URL(row.name, presetFile).href } : {}),
+    ...(row.group ? { config: anchor(row.config) } : {})
+  }))
+  const metadata = parseYaml(await readFile(new URL('./presets/auto/preset.yml', import.meta.url), 'utf8'))
+  const unregister = await ctx.agentPresets.register({ id: 'auto', name: metadata.name, description: metadata.description, order: metadata.order, plugins: anchor(plugins) })
+  ctx.effect(() => unregister, 'dsh-auto-preset-router.preset()')
+  // Keep persisted sessions using the retired id resumable without a duplicate chooser row.
+  for (const method of ['resolve', 'mount', 'acquireScope']) {
+    const previous = ctx.agentPresets[method]
+    const index = method === 'mount' ? 1 : 0
+    function compatible(...args) {
+      if (args[index] === 'code') args[index] = 'ptc'
+      return previous.apply(this, args)
+    }
+    ctx.agentPresets[method] = compatible
+    ctx.effect(() => () => { if (ctx.agentPresets[method] === compatible) ctx.agentPresets[method] = previous })
+  }
 }
 
 export { AUTO_PRESET_ROOT, installPresetRoot, mergePresetLists } from './lib/config.js'
