+/// Check the live WindowServer front process and exact AX key window without
+/// changing focus. Used between characters of a window-scoped HID text action.
+pub fn require_foreground_window(target_pid: i32, target_wid: u32) -> anyhow::Result<()> {
+    let mut current_psn = [0u8; 8];
+    let current_ok = get_front_process_fn()
+        .map(|f| unsafe { f(current_psn.as_mut_ptr() as *mut c_void) } == 0)
+        .unwrap_or(false);
+    let mut target_psn = [0u8; 8];
+    let target_ok = get_process_psn_for_window(target_wid, target_pid, &mut target_psn);
+    let focused_window_id = crate::ax::bindings::focused_window_id_of_pid(target_pid);
+    if target_ok
+        && preserves_exact_existing_focus(current_ok, current_psn, target_psn, focused_window_id, target_wid)
+    {
+        return Ok(());
+    }
+    anyhow::bail!("foreground input target changed; text may be partially delivered; observe before further input")
+}
