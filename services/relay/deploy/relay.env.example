NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DB_PATH=/var/lib/dsh-relay/private-relay.sqlite
# Keep an existing deployment's address unchanged during the code upgrade.
# Desktop uses its reachable internal origin; optional phone mappings can differ.
PUBLIC_RELAY_URL=https://relay.example.com:8443
# Optional aliases of the SAME running relay instance. Replace these example IPs.
# RELAY_CLIENT_ENDPOINTS='[{"origin":"https://10.80.0.9:8443","network":"private"},{"origin":"https://203.0.113.9:9443","network":"public"}]'
