{
  "name": "dsh-relay",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx src/private-server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/private-server.js",
    "test": "tsx --test test/*.test.ts",
    "test:deployment": "tsx --test test/private-deployment.test.ts",
    "start:private": "node dist/private-server.js",
    "start:collaboration": "node dist/collab-server.js",
    "admin:collaboration": "node dist/collab-admin.js",
    "admin:private": "tsx src/private-admin.ts",
    "start:upstream": "node dist/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
