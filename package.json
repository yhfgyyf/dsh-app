{
  "name": "dsh-app",
  "version": "0.1.3",
  "private": true,
  "description": "Independent desktop application for DeepSeek Harness on macOS and Windows",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "prepare:runtime": "node scripts/prepare-runtime.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.ts",
    "start": "npm run build && electron .",
    "fixture": "node scripts/fixture.ts",
    "start:fixture": "node scripts/launch-fixture.ts",
    "test:integration": "node scripts/test-integration.ts",
    "test:tools": "node scripts/test-tools.ts",
    "test:model-settings": "node scripts/test-model-settings.ts",
    "test:audit-switch": "node scripts/test-audit-switch.mjs",
    "install:audit-compat": "node scripts/install-audit-compat.mjs --apply",
    "test:native": "electron tests/native-smoke.cjs",
    "test:sidebar-browser": "electron tests/sidebar-browser.cjs",
    "test:artifact-links": "electron tests/artifact-links.cjs",
    "test:updates": "electron tests/updates-native.cjs",
    "package": "npm run check && node scripts/package.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "setup:runtime": "node scripts/bootstrap-runtime.ts",
    "test:three-surfaces": "node scripts/test-three-surfaces.ts",
    "package:windows": "npm run check && node scripts/package-windows.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-client-modules": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-alpha.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-dockkit": "0.1.5-alpha.1",
    "@electron/packager": "20.3.0",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "electron": "42.11.2",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhfgyyf/dsh-app.git"
  },
  "homepage": "https://github.com/yhfgyyf/dsh-app"
}
